includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    # Published vendor config that refers to the optional Media Library Pro package.
    excludePaths:
        - config/media-library.php

    level: 7
